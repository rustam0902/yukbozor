NODE_ENV=production
PORT=5000

# База данных PostgreSQL (Neon Serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT секрет (минимум 32 символа, случайная строка)
SESSION_SECRET=your_very_long_random_secret_here_minimum_32_chars

# SMS-брокер (Play Mobile)
SMS_API_URL=https://send.smsbroker.uz/v2
SMS_LOGIN=your_sms_login
SMS_PASSWORD=your_sms_password

# Telegram-боты
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ANNOUNCEMENTS_BOT_TOKEN=your_telegram_announcements_bot_token

# Didox (электронный документооборот)
DIDOX_PARTNER_TOKEN=your_didox_partner_token

# E-IMZO (электронная подпись) — URL внешнего VPS
EIMZO_SERVER_URL=http://your-eimzo-vps-ip:8080
